:root{
  --bg:#0b0b0b;
  --text:#ffffff;
  --muted:#999;
  --card:#141414;
}

.light-mode{
  --bg:#f5f5f5;
  --text:#111;
  --muted:#555;
  --card:#ffffff;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',sans-serif;
  overflow-x:hidden;
  transition:0.4s;
}

/* LOADER */

.loader{
  position:fixed;
  inset:0;
  background:black;
  z-index:9999;
  display:flex;
  justify-content:center;
  align-items:center;
}

.loader h1{
  font-size:4rem;
  letter-spacing:10px;
}

/* CURSOR */

.cursor{
  width:20px;
  height:20px;
  border:1px solid white;
  border-radius:50%;
  position:fixed;
  pointer-events:none;
  transform:translate(-50%,-50%);
  z-index:99999;
  transition:transform .1s;
}

/* GRAIN */

.grain{
  position:fixed;
  inset:0;
  background-image:url("https://grainy-gradients.vercel.app/noise.svg");
  opacity:0.05;
  pointer-events:none;
  z-index:999;
}

/* NAV */

.navbar{
  position:fixed;
  top:0;
  width:100%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:30px 60px;
  z-index:1000;
  backdrop-filter:blur(20px);
}

.logo{
  font-weight:900;
  letter-spacing:3px;
}

nav a{
  color:var(--text);
  text-decoration:none;
  margin:0 15px;
  opacity:0.7;
}

nav a:hover{
  opacity:1;
}

#theme-toggle{
  background:none;
  border:none;
  color:var(--text);
  cursor:pointer;
  font-size:1.2rem;
}

/* HERO */

.hero{
  min-height:100vh;
  padding:180px 60px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.hero-sub{
  color:var(--muted);
  margin-bottom:30px;
  letter-spacing:2px;
}

.hero-title{
  font-size:9vw;
  line-height:0.9;
  font-family:'Cormorant Garamond',serif;
  margin-bottom:50px;
}

/* MAGNETIC BUTTON */

.magnetic-btn{
  width:max-content;
  padding:18px 40px;
  border:1px solid var(--text);
  border-radius:100px;
  color:var(--text);
  text-decoration:none;
  transition:0.3s;
  position:relative;
}

.magnetic-btn:hover{
  background:var(--text);
  color:var(--bg);
}

/* MARQUEE */

.marquee{
  overflow:hidden;
  white-space:nowrap;
  border-top:1px solid #222;
  border-bottom:1px solid #222;
  padding:20px 0;
}

.marquee-track{
  display:inline-block;
  animation:marquee 20s linear infinite;
  font-size:2rem;
  color:var(--muted);
}

@keyframes marquee{
  from{
    transform:translateX(0);
  }
  to{
    transform:translateX(-50%);
  }
}

/* PROJECTS */

.projects{
  padding:120px 60px;
}

.projects h2{
  font-size:4rem;
  margin-bottom:60px;
}

#projects-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:30px;
}

.project-card{
  background:var(--card);
  border-radius:24px;
  overflow:hidden;
  transition:0.5s;
  cursor:pointer;
  position:relative;
}

.project-card:hover{
  transform:translateY(-12px);
}

.project-card img{
  width:100%;
  height:420px;
  object-fit:cover;
  transition:0.6s;
}

.project-card:hover img{
  transform:scale(1.08);
}

.project-info{
  padding:25px;
}

.project-info h3{
  font-size:1.5rem;
  margin-bottom:10px;
}

.project-info p{
  color:var(--muted);
}

/* ABOUT */

.about{
  padding:120px 60px;
}

.about h2{
  font-size:4rem;
  margin-bottom:40px;
}

.about p{
  max-width:700px;
  font-size:1.4rem;
  line-height:1.8;
  color:var(--muted);
}

/* CONTACT */

.contact{
  padding:150px 60px;
  text-align:center;
}

.contact h2{
  font-size:5rem;
  margin-bottom:40px;
  font-family:'Cormorant Garamond',serif;
}

/* FOOTER */

footer{
  padding:40px;
  text-align:center;
  border-top:1px solid #222;
  color:var(--muted);
}

/* MOBILE */

@media(max-width:768px){

  .navbar{
    padding:20px;
  }

  .hero{
    padding:160px 20px;
  }

  .hero-title{
    font-size:20vw;
  }

  .projects,
  .about,
  .contact{
    padding:100px 20px;
  }

  .contact h2{
    font-size:3rem;
  }

}
