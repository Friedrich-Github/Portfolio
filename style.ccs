:root{
  --bg:#050505;
  --text:#fff;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',sans-serif;
  overflow-x:hidden;
}

/* CURSOR */

.cursor{
  width:18px;
  height:18px;
  border:1px solid white;
  border-radius:50%;
  position:fixed;
  pointer-events:none;
  z-index:99999;
  transform:translate(-50%,-50%);
}

/* PAGE TRANSITION */

.page-transition{
  position:fixed;
  inset:0;
  background:white;
  z-index:999999;
  transform:translateY(100%);
}

/* GRAIN */

.grain{
  position:fixed;
  inset:0;
  opacity:0.04;
  pointer-events:none;
  background-image:url("https://grainy-gradients.vercel.app/noise.svg");
  z-index:999;
}

/* SCROLL BAR */

.scroll-progress{
  position:fixed;
  top:0;
  left:0;
  width:0%;
  height:3px;
  background:white;
  z-index:999999;
}

/* NAV */

.navbar{
  position:fixed;
  width:100%;
  display:flex;
  justify-content:space-between;
  padding:30px 60px;
  z-index:1000;
}

.menu-btn{
  background:none;
  border:none;
  color:white;
  font-size:1rem;
  cursor:pointer;
}

/* MENU */

.menu-overlay{
  position:fixed;
  inset:0;
  background:#0a0a0a;
  z-index:9999;
  display:flex;
  justify-content:center;
  align-items:center;
  transform:translateY(-100%);
}

.menu-links{
  display:flex;
  flex-direction:column;
  gap:40px;
}

.menu-links a{
  color:white;
  text-decoration:none;
  font-size:4rem;
  font-family:'Cormorant Garamond',serif;
}

/* HERO */

.hero{
  height:100vh;
  position:relative;
  display:flex;
  align-items:center;
  padding:0 60px;
}

.hero-video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.hero-overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.5);
}

.hero-content{
  position:relative;
  z-index:10;
}

.hero-sub{
  margin-bottom:30px;
  letter-spacing:2px;
}

.hero h1{
  font-size:9vw;
  line-height:0.9;
  font-family:'Cormorant Garamond',serif;
  margin-bottom:40px;
}

/* BUTTON */

.magnetic-btn{
  display:inline-block;
  padding:18px 40px;
  border:1px solid white;
  border-radius:100px;
  color:white;
  text-decoration:none;
}

/* BLUR */

.blur{
  position:absolute;
  border-radius:50%;
  filter:blur(120px);
}

.blur-1{
  width:300px;
  height:300px;
  background:#6e00ff;
  top:20%;
  left:10%;
}

.blur-2{
  width:300px;
  height:300px;
  background:#006eff;
  bottom:10%;
  right:10%;
}

/* PROJECTS */

.projects{
  padding:140px 60px;
}

.projects h2{
  font-size:5rem;
  margin-bottom:80px;
}

.projects-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:30px;
}

.project-card{
  border-radius:30px;
  overflow:hidden;
  transform-style:preserve-3d;
}

.project-card img{
  width:100%;
  height:500px;
  object-fit:cover;
}

/* STICKY */

.sticky-section{
  display:flex;
  min-height:200vh;
  padding:100px 60px;
}

.sticky-left{
  width:50%;
  position:sticky;
  top:20%;
  height:fit-content;
}

.sticky-left h2{
  font-size:5rem;
  line-height:1;
}

.sticky-right{
  width:50%;
}

.sticky-right img{
  width:100%;
  border-radius:30px;
}

/* ABOUT */

.about{
  padding:140px 60px;
}

.about h2{
  font-size:5rem;
  margin-bottom:40px;
}

.about p{
  max-width:700px;
  font-size:1.4rem;
  line-height:1.8;
}

/* CONTACT */

.contact{
  padding:180px 60px;
  text-align:center;
}

.contact h2{
  font-size:6rem;
  margin-bottom:50px;
  font-family:'Cormorant Garamond',serif;
}

/* MOBILE */

@media(max-width:768px){

  .hero,
  .projects,
  .about,
  .contact,
  .sticky-section{
    padding:100px 20px;
  }

  .hero h1{
    font-size:20vw;
  }

  .sticky-section{
    flex-direction:column;
  }

  .sticky-left,
  .sticky-right{
    width:100%;
  }

}
