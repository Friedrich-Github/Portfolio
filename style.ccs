*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#0a0a0a;
  color:white;
  font-family:'Inter',sans-serif;
  overflow-x:hidden;
}

/* NAVBAR */

.navbar{
  position:fixed;
  width:100%;
  top:0;
  left:0;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:30px 60px;
  z-index:1000;
  background:rgba(10,10,10,0.7);
  backdrop-filter:blur(10px);
}

.logo{
  font-weight:800;
  letter-spacing:2px;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:30px;
  opacity:0.7;
  transition:0.3s;
}

nav a:hover{
  opacity:1;
}

/* HERO */

.hero{
  min-height:100vh;
  padding:180px 60px 100px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.hero-top p{
  color:#888;
  margin-bottom:30px;
  text-transform:uppercase;
  letter-spacing:2px;
}

.hero h1{
  font-size:10vw;
  line-height:0.9;
  font-weight:900;
  margin-bottom:40px;
}

.hero-description{
  max-width:600px;
}

.hero-description p{
  font-size:1.2rem;
  color:#aaa;
  line-height:1.7;
}

/* SECTIONS */

.section-title{
  font-size:3rem;
  font-weight:800;
  margin-bottom:50px;
}

.projects{
  padding:100px 60px;
}

.project-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:30px;
}

.project-card{
  background:#111;
  border-radius:20px;
  overflow:hidden;
  transition:0.4s ease;
  cursor:pointer;
}

.project-card:hover{
  transform:translateY(-10px);
}

.project-card img{
  width:100%;
  height:400px;
  object-fit:cover;
}

.project-info{
  padding:25px;
}

.project-info h3{
  margin-bottom:10px;
}

.project-info p{
  color:#888;
}

/* ABOUT */

.about{
  padding:100px 60px;
}

.about p{
  max-width:700px;
  font-size:1.3rem;
  line-height:1.8;
  color:#aaa;
}

/* CONTACT */

.contact{
  padding:120px 60px;
  text-align:center;
}

.contact h2{
  font-size:4rem;
  margin-bottom:40px;
}

.contact-btn{
  display:inline-block;
  padding:18px 40px;
  border:1px solid white;
  color:white;
  text-decoration:none;
  border-radius:50px;
  transition:0.3s;
}

.contact-btn:hover{
  background:white;
  color:black;
}

/* FOOTER */

footer{
  padding:40px;
  text-align:center;
  color:#666;
  border-top:1px solid #222;
}

/* ANIMATION */

.fade-up{
  opacity:0;
  transform:translateY(40px);
  transition:1s ease;
}

.fade-up.active{
  opacity:1;
  transform:translateY(0);
}

/* MOBILE */

@media(max-width:768px){

  .navbar{
    padding:20px;
  }

  .hero{
    padding:140px 20px 80px;
  }

  .hero h1{
    font-size:22vw;
  }

  .projects,
  .about,
  .contact{
    padding:80px 20px;
  }

  .contact h2{
    font-size:2.5rem;
  }

}
